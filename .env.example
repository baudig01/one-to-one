# Firebase Configuration
# Créer un projet sur https://console.firebase.google.com
# Puis copier les valeurs depuis Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Note: Sans ces variables, l'app utilise localStorage automatiquement

# Code d'accès admin (optionnel)
VITE_ADMIN_CODE=votre_code_secret
